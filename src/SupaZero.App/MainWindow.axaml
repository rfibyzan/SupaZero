<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SupaZero.App.ViewModels"
        x:Class="SupaZero.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="SupaZero" Icon="/Assets/logo.ico" Width="980" Height="700" MinWidth="780" MinHeight="520"
        Background="{DynamicResource OfBg}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44">
  <!-- Same layout as SupaFisch: title + badge, top tab strip, connection strip, page header + Stopped/Running. -->
  <Grid RowDefinitions="44,Auto,Auto,Auto,*">
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
      <Border Width="26" Height="26" CornerRadius="6" ClipToBounds="True">
        <Image Source="/Assets/logo.png" Stretch="UniformToFill" />
      </Border>
      <TextBlock Text="SupaZero" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
    <!-- v0.3.32: app mode switch (like RIE expert/newbie). Right margin leaves room for the window caption buttons. -->
    <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,150,0"
                IsEnabled="{Binding CanSwitchMode}" ToolTip.Tip="App mode. Carry adds the Carry tab (damage target + carry windows). Locked while running.">
      <ToggleButton Content="Normal" IsChecked="{Binding NormalMode, Mode=OneWay}" Command="{Binding SetModeCommand}" CommandParameter="Normal"
                    Padding="12,3" CornerRadius="6,0,0,6" />
      <ToggleButton Content="Carry" IsChecked="{Binding CarryMode, Mode=OneWay}" Command="{Binding SetModeCommand}" CommandParameter="Carry"
                    Padding="12,3" CornerRadius="0,6,6,0" />
    </StackPanel>

    <Border Grid.Row="1" BorderBrush="{DynamicResource OfBorder}" BorderThickness="0,0,0,1" Margin="14,4,14,0" Padding="0,0,0,8">
      <ListBox Classes="tabs" ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTabIndex}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TabViewModel"><TextBlock Text="{Binding Title}" /></DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Border Grid.Row="2" Classes="strip" Margin="14,8,14,0">
      <TextBlock Text="{Binding ConnectionText}" TextTrimming="CharacterEllipsis" />
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="14,12,14,6" IsVisible="{Binding ShowHeader}">
      <TextBlock Classes="h1" Text="{Binding HeaderTitle}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Ellipse Width="8" Height="8" Fill="{DynamicResource OfAccent}" VerticalAlignment="Center" />
        <TextBlock Classes="muted" Text="{Binding RunStateText}" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="4" Margin="14,4,14,14" HorizontalScrollBarVisibility="Disabled">
      <ContentControl Content="{Binding SelectedTab.Content}" />
    </ScrollViewer>
  </Grid>
</Window>
