<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SupaZero.App.ViewModels"
             x:Class="SupaZero.App.Views.UpgradeView"
             x:DataType="vm:UpgradeViewModel">
  <Grid ColumnDefinitions="*,*">
    <Border Classes="card" Margin="0,0,8,0" VerticalAlignment="Top">
      <StackPanel Spacing="6">
        <TextBlock Classes="h2" Text="Auto upgrade" />
        <Border Classes="sep" Margin="0,2,0,4" />
        <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Upgrade di lobby (unit terpilih)" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" /></Grid>
        <Grid ColumnDefinitions="*,220" MinHeight="34">
          <TextBlock Classes="label" Text="Mode" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}" />
        </Grid>
        <Grid ColumnDefinitions="*,150" MinHeight="34">
          <TextBlock Classes="label" Text="Maks beli per kunjungan lobby" />
          <NumericUpDown Grid.Column="1" Value="{Binding MaxBuysPerStage}" Minimum="0" Maximum="20" Increment="1" FormatString="0" />
        </Grid>
        <Grid ColumnDefinitions="*,220" MinHeight="34">
          <TextBlock Classes="label" Text="Unit target (kosong = unit terpilih)" />
          <TextBox Grid.Column="1" Text="{Binding OnlyUnit}" Watermark="mis. Shadow Lord" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Mode uji (tanpa klik Buy)" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding DryRun}" /></Grid>
        <Border Classes="sep" Margin="0,4" />
        <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                   Text="Di lobby sebelum ke room: Units → SkillTree unit yang sedang terpilih → klik node bertanda ! (harga ≤ token) → Buy → berhasil bila token turun → tutup X. Prioritas: habiskan kolom ON teratas dulu. Bergiliran: satu node per kolom ON bergantian.  Bila Unit target diisi dan unit terpilih beda: klik unit di daftar bawah (scroll bila perlu) satu per satu sampai namanya cocok; tidak ketemu = tidak membeli. Mode uji: buka Units, pilih node, pastikan tombol Buy terbaca, tulis rencana di log, tutup X, lalu macro berhenti tanpa membeli." />
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Classes="card" Margin="8,0,0,0" VerticalAlignment="Top">
      <StackPanel Spacing="6">
        <TextBlock Classes="h2" Text="Kolom yang di-upgrade" />
        <Border Classes="sep" Margin="0,2,0,4" />
        <Border Classes="row" Margin="0,0,0,6"><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="label" Text="ATK" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding Atk}" /></Grid></Border>
        <Border Classes="row" Margin="0,0,0,6"><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="label" Text="CRIT" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding Crit}" /></Grid></Border>
        <Border Classes="row" Margin="0,0,0,6"><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="label" Text="SPD" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding Spd}" /></Grid></Border>
        <Border Classes="row" Margin="0,0,0,6"><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="label" Text="DEF" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding Def}" /></Grid></Border>
        <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="Hanya kolom ON yang dibeli. Semua OFF = tidak membeli apa pun. Bila lebih dari satu ON, urutan ATK → CRIT → SPD → DEF mengikuti Mode." />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
