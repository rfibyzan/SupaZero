<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SupaZero.App.ViewModels"
             x:Class="SupaZero.App.Views.UpgradeView"
             x:DataType="vm:UpgradeViewModel">
  <Grid ColumnDefinitions="*,*">
    <Border Classes="card" Margin="0,0,8,0" VerticalAlignment="Top">
      <StackPanel Spacing="6">
        <TextBlock Classes="h2" Text="Auto upgrade" />
        <Border Classes="sep" Margin="0,2,0,4" />
        <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Upgrade di lobby (unit terpilih)" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" /></Grid>
        <Grid ColumnDefinitions="*,220" MinHeight="34">
          <TextBlock Classes="label" Text="Mode" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}" />
        </Grid>
        <Grid ColumnDefinitions="*,150" MinHeight="34">
          <TextBlock Classes="label" Text="Maks beli per kunjungan lobby" />
          <NumericUpDown Grid.Column="1" Value="{Binding MaxBuysPerStage}" Minimum="0" Maximum="20" Increment="1" FormatString="0" />
        </Grid>
        <Border Classes="sep" Margin="0,4" />
        <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                   Text="Di lobby sebelum ke room: Units → SkillTree unit yang sedang terpilih → klik node bertanda ! (harga ≤ token) → Buy → berhasil bila token turun → tutup X. Prioritas: habiskan kolom teratas dulu. Bergiliran: satu node per kolom bergantian. Unit tidak diganti." />
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Classes="card" Margin="8,0,0,0" VerticalAlignment="Top">
      <StackPanel Spacing="6">
        <TextBlock Classes="h2" Text="Prioritas kolom" />
        <Border Classes="sep" Margin="0,2,0,4" />
        <ItemsControl ItemsSource="{Binding Priority}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PriorityItemViewModel">
              <Border Classes="row" Margin="0,0,0,6">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Classes="label" Text="{Binding Name}" />
                  <Button Grid.Column="1" Content="Naik" Command="{Binding UpCommand}" Padding="10,3" Margin="0,0,6,0" />
                  <Button Grid.Column="2" Content="Turun" Command="{Binding DownCommand}" Padding="10,3" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
