<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SupaZero.App.ViewModels"
             x:Class="SupaZero.App.Views.StoryView"
             x:DataType="vm:StoryViewModel">
  <Grid ColumnDefinitions="*,*">
    <Border Classes="card" Margin="0,0,8,0" VerticalAlignment="Top">
      <StackPanel Spacing="6">
        <TextBlock Classes="h2" Text="Story setup" />
        <Border Classes="sep" Margin="0,2,0,4" />
        <Grid ColumnDefinitions="*,190" MinHeight="34">
          <TextBlock Classes="label" Text="Map" />
          <TextBox Grid.Column="1" Text="{Binding Map}" Watermark="kosong = map terpilih" />
        </Grid>
        <Grid ColumnDefinitions="*,190" MinHeight="34">
          <TextBlock Classes="label" Text="Act" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Acts}" SelectedIndex="{Binding ActIndex}" />
        </Grid>
        <Grid ColumnDefinitions="*,190" MinHeight="34">
          <TextBlock Classes="label" Text="Difficulty" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Difficulties}" SelectedIndex="{Binding DifficultyIndex}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Auto create lobby" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCreateLobby}" /></Grid>
        <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Auto vote Start (Yes)" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoVoteStart}" /></Grid>
        <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Auto Next stage" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoNext}" /></Grid>
        <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Retry saat DEFEAT" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding RetryOnDefeat}" /></Grid>
        <Grid ColumnDefinitions="*,190" MinHeight="34">
          <TextBlock Classes="label" Text="Maks retry per stage" />
          <NumericUpDown Grid.Column="1" Value="{Binding MaxRetries}" Minimum="0" Maximum="20" Increment="1" FormatString="0" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Classes="card" Margin="8,0,0,0" VerticalAlignment="Top">
      <StackPanel Spacing="6">
        <TextBlock Classes="h2" Text="Combat" />
        <Border Classes="sep" Margin="0,2,0,4" />
        <Grid ColumnDefinitions="*,150" MinHeight="34">
          <TextBlock Classes="label" Text="Interval serangan (ms)" />
          <NumericUpDown Grid.Column="1" Value="{Binding AttackIntervalMs}" Minimum="30" Maximum="2000" Increment="10" FormatString="0" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Pakai skill" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding UseSkills}" /></Grid>
        <Grid ColumnDefinitions="*,150" MinHeight="34">
          <TextBlock Classes="label" Text="Tombol skill" />
          <TextBox Grid.Column="1" Text="{Binding SkillKeys}" Watermark="1,2,3" />
        </Grid>
        <Grid ColumnDefinitions="*,150" MinHeight="34">
          <TextBlock Classes="label" Text="Interval skill (ms)" />
          <NumericUpDown Grid.Column="1" Value="{Binding SkillIntervalMs}" Minimum="200" Maximum="10000" Increment="100" FormatString="0" />
        </Grid>
        <Border Classes="sep" Margin="0,4" />
        <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                   Text="Navigasi antar-area dan penghancuran boulder (HxH Act 1-3) belum otomatis. Saat area bersih, macro menunggu kamu menggerakkan karakter." />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
