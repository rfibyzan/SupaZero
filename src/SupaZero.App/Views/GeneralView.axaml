<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SupaZero.App.ViewModels"
             x:Class="SupaZero.App.Views.GeneralView"
             x:DataType="vm:GeneralViewModel">
  <!-- General: left hotkey + farm target + compact Combat/Navigation rows, right overlay + powers + calibration, bottom Log.
       v0.3.51 (Byzan 28 Oct): the Combat tab moved here as compact rows; Open shows that section alone with a back arrow. -->
  <Panel>
  <Grid ColumnDefinitions="3*,2*" RowDefinitions="Auto,Auto" IsVisible="{Binding Nav.IsList}">
    <StackPanel Spacing="8" Margin="0,0,8,0">
      <Border Classes="card" Padding="0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Background="{DynamicResource OfAccentDim}" CornerRadius="8,0,0,8" MinWidth="72" Padding="12,14"
                  BorderBrush="{DynamicResource OfBorder}" BorderThickness="0,0,1,0">
            <TextBlock Text="{Binding HotkeyText}" Classes="accent" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Grid.Column="1" Text="Macro hotkey" Classes="h2" VerticalAlignment="Center" Margin="14,0" />
          <Button Grid.Column="2" Content="{Binding RebindText}" Command="{Binding RebindCommand}"
                  MinWidth="104" HorizontalContentAlignment="Center" Margin="12" />
        </Grid>
      </Border>
      <TextBlock Classes="muted" FontSize="11" Text="{Binding HotkeyStatus}" Margin="4,-4,0,0" TextWrapping="Wrap" />

      <Border Classes="card" DataContext="{Binding Root.Farm}" x:DataType="vm:FarmViewModel">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="Target farm" />
          <Border Classes="sep" Margin="0,2,0,4" />
          <Grid ColumnDefinitions="*,210" MinHeight="34">
            <TextBlock Classes="label" Text="Mode" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}" />
          </Grid>
          <Grid ColumnDefinitions="*,210" MinHeight="34">
            <TextBlock Classes="label" Text="Map" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}" />
          </Grid>
          <TextBlock Classes="muted" FontSize="11" Text="{Binding MapsHint}" TextWrapping="Wrap" Margin="0,-2,0,2" />
          <Grid ColumnDefinitions="*,210" MinHeight="34">
            <TextBlock Classes="label" Text="Act" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Acts}" SelectedIndex="{Binding ActIndex}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding ActProgressText}" />
            <Button Grid.Column="1" Content="Reset" Command="{Binding ResetActProgressCommand}" Padding="8,2" Margin="6,0,0,0" />
          </Grid>
          <Grid ColumnDefinitions="*,210" MinHeight="34">
            <TextBlock Classes="label" Text="Difficulty" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Difficulties}" SelectedIndex="{Binding DifficultyIndex}" />
          </Grid>
          <Grid ColumnDefinitions="*,210" MinHeight="34">
            <TextBlock Classes="label" Text="After victory" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding AfterWins}" SelectedIndex="{Binding AfterWinIndex}"
                      ToolTip.Tip="Automatic: Story → Next, other modes → Retry." />
          </Grid>
        </StackPanel>
      </Border>
        <Border Classes="card" Padding="14,10">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Classes="label" FontWeight="SemiBold" Text="{Binding CombatSection.Title}" />
              <TextBlock Classes="muted" FontSize="11" Text="{Binding CombatSection.Summary}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Content="Open" Command="{Binding CombatSection.OpenCommand}" Padding="12,3" Margin="10,0,0,0" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Border Classes="card" Padding="14,10">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Classes="label" FontWeight="SemiBold" Text="{Binding NavigationSection.Title}" />
              <TextBlock Classes="muted" FontSize="11" Text="{Binding NavigationSection.Summary}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Content="Open" Command="{Binding NavigationSection.OpenCommand}" Padding="12,3" Margin="10,0,0,0" VerticalAlignment="Center" />
          </Grid>
        </Border>
    </StackPanel>

    <StackPanel Grid.Column="1" Spacing="8" Margin="8,0,0,0">
      <Border Classes="card" DataContext="{Binding Root.SettingsPage}" x:DataType="vm:SettingsPageViewModel">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Running Overlay" />
          <StackPanel HorizontalAlignment="Center">
            <!-- Screen = scaled-down Roblox window; box = overlay position, draggable. -->
            <Border Width="220" Height="124" BorderBrush="{DynamicResource OfMuted}" BorderThickness="2" CornerRadius="6" Background="{DynamicResource OfInset}">
              <Canvas x:Name="PreviewArea" Width="216" Height="120" ClipToBounds="True" Background="Transparent">
                <Border x:Name="PreviewBox" Width="{Binding PreviewBoxWidth}" Height="{Binding PreviewBoxHeight}" CornerRadius="3"
                        Background="#C0101418" BorderBrush="{DynamicResource OfAccent}" BorderThickness="1"
                        Canvas.Left="{Binding PreviewLeft}" Canvas.Top="{Binding PreviewTop}" Cursor="SizeAll"
                        ToolTip.Tip="Overlay. Drag to move it within the Roblox window.">
                  <StackPanel Spacing="3" VerticalAlignment="Top" Margin="4,5,4,0">
                    <Border Height="2" Background="#C0FFFFFF" Width="12" HorizontalAlignment="Left" />
                    <Border Height="2" Background="#80FFFFFF" Width="16" HorizontalAlignment="Left" />
                    <Border Height="2" Background="#80FFFFFF" Width="14" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </Canvas>
            </Border>
            <Border Width="12" Height="8" Background="{DynamicResource OfMuted}" HorizontalAlignment="Center" />
            <Border Width="60" Height="3" Background="{DynamicResource OfMuted}" CornerRadius="1" HorizontalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="11" HorizontalAlignment="Center" Text="Drag the box to place the overlay in the Roblox window." />
          <Grid ColumnDefinitions="*,Auto" MinHeight="30"><TextBlock Classes="label" Text="Show overlay while the macro runs" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowOverlay}" /></Grid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="Equipped powers" />
          <Border Classes="sep" Margin="0,2,0,4" />
          <StackPanel Spacing="1">
            <Grid ColumnDefinitions="56,*"><TextBlock Classes="label" Text="Slot 1" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Power1Name}" TextTrimming="CharacterEllipsis" /></Grid>
            <TextBlock Classes="muted" FontSize="11" Margin="56,0,0,0" Text="{Binding Power1Detail}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="1" Margin="0,4,0,0">
            <Grid ColumnDefinitions="56,*"><TextBlock Classes="label" Text="Slot 2" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Power2Name}" TextTrimming="CharacterEllipsis" /></Grid>
            <TextBlock Classes="muted" FontSize="11" Margin="56,0,0,0" Text="{Binding Power2Detail}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Classes="label" FontWeight="SemiBold" Text="Calibration" />
              <TextBlock Classes="muted" FontSize="11" Text="{Binding CalibrationSummary}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Content="Calibrate" Command="{Binding CalibrateActionCommand}" Padding="12,3"
                      ToolTip.Tip="From the lobby: checks Trait, opens Spinning (reads powers), enters a room, reads all modes/maps/acts, then Leaves. Does not press Start. Afterwards the Details list is refreshed." />
              <Button Content="Redeem codes" Command="{Binding RedeemCodesCommand}" Padding="12,3"
                      ToolTip.Tip="From the lobby: opens Codes, types every code from beebom.com (+ extra codes on the Modes tab) not yet redeemed by this account, reads the result, closes Codes, then stops." />
            </StackPanel>
          </Grid>
          <Expander Header="Details" IsVisible="{Binding HasCalibration}" Padding="4" FontSize="11" HorizontalAlignment="Stretch">
            <ItemsControl ItemsSource="{Binding CalibrationItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="18,110,*" MinHeight="16">
                    <TextBlock Text="{Binding Icon}" FontSize="11" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Classes="muted" FontSize="11" Text="{Binding Name}" />
                    <TextBlock Grid.Column="2" FontSize="11" Text="{Binding Value}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </StackPanel>
      </Border>
    </StackPanel>

    <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="card" Margin="0,8,0,0">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="h2" Text="Log" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Clear" Command="{Binding ClearLogCommand}" Padding="10,3" />
        </Grid>
        <ListBox ItemsSource="{Binding Root.LogLines}" Height="190" Background="{DynamicResource OfInset}" FontSize="11">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="10,3" />
              <Setter Property="MinHeight" Value="0" />
            </Style>
          </ListBox.Styles>
        </ListBox>
      </StackPanel>
    </Border>
  </Grid>

  <!-- Detail page of the open section. -->
  <StackPanel Spacing="10" IsVisible="{Binding Nav.IsDetail}">
    <Grid ColumnDefinitions="Auto,*">
      <Button Classes="back" Content="←" Command="{Binding Nav.BackCommand}" ToolTip.Tip="Back" />
      <TextBlock Grid.Column="1" Classes="h1" Text="{Binding Nav.CurrentTitle}" VerticalAlignment="Center" Margin="12,0,0,0" />
    </Grid>
    <Border Classes="card" IsVisible="{Binding CombatSection.IsOpen}">
      <StackPanel Spacing="6" DataContext="{Binding Root.Farm}" x:DataType="vm:FarmViewModel">
        <Grid ColumnDefinitions="*,150" MinHeight="34">
          <TextBlock Classes="label" Text="Basic attack (ms)" />
          <NumericUpDown Grid.Column="1" Value="{Binding AttackIntervalMs}" Minimum="30" Maximum="2000" Increment="10" FormatString="0" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Auto shift lock during rounds (enemies present = always on)" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoShiftLock}" /></Grid>
        <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Ultimate (G) only on bosses (boss bar shown, not IMMUNE)" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding UltBossOnly}" /></Grid>
        <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Shadow Lord: auto Arise on Shadow Gate (hold E on corpses)" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoArise}" /></Grid>
        <ItemsControl ItemsSource="{Binding SkillRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SkillRowViewModel">
              <Border Classes="card" Padding="0" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <Border Background="{DynamicResource OfAccentDim}" CornerRadius="8,0,0,8" MinWidth="48" Padding="10,8"
                          BorderBrush="{DynamicResource OfBorder}" BorderThickness="0,0,1,0">
                    <TextBlock Text="{Binding KeyText}" Classes="accent" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Classes="label" Text="{Binding Name}" Margin="10,0" />
                  <Button Grid.Column="2" Content="{Binding RebindText}" Command="{Binding RebindCommand}" Padding="10,4" MinWidth="78"
                          HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="3" IsChecked="{Binding Enabled}" Margin="8,0,4,0" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Border Classes="card" IsVisible="{Binding NavigationSection.IsOpen}">
      <StackPanel Spacing="6" DataContext="{Binding Root.Farm}" x:DataType="vm:FarmViewModel">
        <Grid ColumnDefinitions="*,150" MinHeight="34">
          <TextBlock Classes="label" Text="Attack range (stud)" />
          <NumericUpDown Grid.Column="1" Value="{Binding AttackRange}" Minimum="2" Maximum="150" Increment="1" FormatString="0" />
        </Grid>
        <Grid ColumnDefinitions="*,150" MinHeight="34">
          <TextBlock Classes="label" Text="Arrive radius (stud)" />
          <NumericUpDown Grid.Column="1" Value="{Binding ArriveRadius}" Minimum="2" Maximum="20" Increment="1" FormatString="0" />
        </Grid>
        <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                   Text="Attack range: distance kept from enemies (± 10%, min 2 stud) while attacking, using skills and circling. Arrive radius: the next area point counts as reached when this close (4–8 recommended)." />
      </StackPanel>
    </Border>
  </StackPanel>
  </Panel>
</UserControl>
