<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SupaZero.App.ViewModels"
             x:Class="SupaZero.App.Views.ModesView"
             x:DataType="vm:ModesPageViewModel">
  <!-- v0.3.14: per-mode settings (Drop Target, Trials, Evil Reflection); v0.3.39 Lobby merged here.
       v0.3.51 (Byzan 28 Oct): compact rows (name, toggle, Open); Open shows that section alone with a back arrow. -->
  <Panel>
    <StackPanel Spacing="8" IsVisible="{Binding Nav.IsList}">
      <Border Classes="card" Padding="14,10">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Classes="label" FontWeight="SemiBold" Text="{Binding DropTrials.Title}" />
            <TextBlock Classes="muted" FontSize="11" Text="{Binding DropTrials.Summary}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2" Content="Open" Command="{Binding DropTrials.OpenCommand}" Padding="12,3" Margin="10,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Border Classes="card" Padding="14,10">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Classes="label" FontWeight="SemiBold" Text="{Binding Lobby.Title}" />
            <TextBlock Classes="muted" FontSize="11" Text="{Binding Lobby.Summary}" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding Farm.AutoCreateLobby}" VerticalAlignment="Center" ToolTip.Tip="Auto create room" />
          <Button Grid.Column="2" Content="Open" Command="{Binding Lobby.OpenCommand}" Padding="12,3" Margin="10,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Border Classes="card" Padding="14,10">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Classes="label" FontWeight="SemiBold" Text="{Binding Blessing.Title}" />
            <TextBlock Classes="muted" FontSize="11" Text="{Binding Blessing.Summary}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2" Content="Open" Command="{Binding Blessing.OpenCommand}" Padding="12,3" Margin="10,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </StackPanel>

    <StackPanel Spacing="10" IsVisible="{Binding Nav.IsDetail}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="back" Content="←" Command="{Binding Nav.BackCommand}" ToolTip.Tip="Back" />
        <TextBlock Grid.Column="1" Classes="h1" Text="{Binding Nav.CurrentTitle}" VerticalAlignment="Center" Margin="12,0,0,0" />
        <ToggleSwitch Grid.Column="2" IsVisible="{Binding Lobby.IsOpen}" IsChecked="{Binding Farm.AutoCreateLobby}" VerticalAlignment="Center" ToolTip.Tip="Auto create room" />
      </Grid>
      <Border Classes="card" IsVisible="{Binding DropTrials.IsOpen}">
        <StackPanel DataContext="{Binding Farm}" x:DataType="vm:FarmViewModel">
          <StackPanel Spacing="8">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,200" MinHeight="34">
                <TextBlock Classes="label" Text="Drop Target" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding DropChoices}" SelectedItem="{Binding SelectedDrop}" />
              </Grid>
              <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding DropHint}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,150" MinHeight="34">
              <TextBlock Classes="label" Text="Trials floor (0 = next floor)" />
              <NumericUpDown Grid.Column="1" Value="{Binding TrialsFloor}" Minimum="0" Maximum="500" Increment="1" FormatString="0" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding Lobby.IsOpen}">
        <StackPanel Spacing="6" DataContext="{Binding Farm}" x:DataType="vm:FarmViewModel">
          <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Auto create room" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCreateLobby}" /></Grid>
          <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                     Text="Automatic: Areas → Story (teleport) → walk to the nearest empty room. Join fails → another circle." />
          <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Skip rooms with other players" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding SkipOccupiedRooms}" /></Grid>
          <Grid ColumnDefinitions="*,150" MinHeight="34">
            <TextBlock Classes="label" Text="Switch circle if join fails (s)" />
            <NumericUpDown Grid.Column="1" Value="{Binding JoinTimeoutSec}" Minimum="2" Maximum="30" Increment="1" FormatString="0" />
          </Grid>
          <TextBlock Classes="label" Text="Codes (button 'Redeem codes' on the General tab)" />
          <TextBox Text="{Binding ExtraCodes}" Watermark="Extra codes (comma separated, optional)" />
          <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding Root.CodesInfo}" />
          <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Auto vote Start (Yes)" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoVoteStart}" /></Grid>
          <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Retry on DEFEAT" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding RetryOnDefeat}" /></Grid>
          <Grid ColumnDefinitions="*,150" MinHeight="34">
            <TextBlock Classes="label" Text="Max retries per stage" />
            <NumericUpDown Grid.Column="1" Value="{Binding MaxRetries}" Minimum="0" Maximum="20" Increment="1" FormatString="0" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Infinite: unlimited retries" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding InfiniteUnlimitedRetry}" /></Grid>
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding Blessing.IsOpen}">
        <StackPanel Spacing="6" DataContext="{Binding Farm}" x:DataType="vm:FarmViewModel">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="muted" FontSize="11" Text="Evil Reflection" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Reset" Command="{Binding ResetBlessingCommand}" Padding="8,2" />
          </Grid>
          <Grid ColumnDefinitions="*,24,*">
          <StackPanel Spacing="6">
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="Buff priority (checked = prioritized, top = most important)" />
            <ItemsControl ItemsSource="{Binding BlessingBuffRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BlessingBuffRowViewModel">
                  <Grid ColumnDefinitions="24,Auto,*,Auto,Auto" Margin="0,1">
                    <TextBlock Classes="muted" Text="{Binding Rank}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" Content="{Binding Label}" />
                    <TextBlock Grid.Column="2" Classes="muted" FontSize="11" Text="{Binding CardsText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
                    <Button Grid.Column="3" Content="▲" Command="{Binding UpCommand}" Padding="6,0" />
                    <Button Grid.Column="4" Content="▼" Command="{Binding DownCommand}" Padding="6,0" Margin="2,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="6">
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="Cards (checked = may be picked, order = tiebreak when buffs are equal)" />
            <ItemsControl ItemsSource="{Binding BlessingCardRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BlessingCardRowViewModel">
                  <Grid ColumnDefinitions="24,Auto,*,Auto,Auto" Margin="0,2">
                    <TextBlock Classes="muted" Text="{Binding Rank}" VerticalAlignment="Top" Margin="0,6,0,0" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="2" Margin="4,0">
                      <TextBlock><Run Text="{Binding Name}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Rarity}" FontSize="11" /></TextBlock>
                      <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding Detail}" />
                      <TextBlock Classes="muted" FontSize="11" Text="{Binding BuffText}" />
                    </StackPanel>
                    <Button Grid.Column="3" Content="▲" Command="{Binding UpCommand}" Padding="6,0" VerticalAlignment="Top" />
                    <Button Grid.Column="4" Content="▼" Command="{Binding DownCommand}" Padding="6,0" Margin="2,0,0,0" VerticalAlignment="Top" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
        <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding BlessingPreview}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Panel>
</UserControl>
