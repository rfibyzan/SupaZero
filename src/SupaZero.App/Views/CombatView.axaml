<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SupaZero.App.ViewModels"
             x:Class="SupaZero.App.Views.CombatView"
             x:DataType="vm:CombatPageViewModel">
  <Grid ColumnDefinitions="*,*" DataContext="{Binding Farm}" x:DataType="vm:FarmViewModel">
    <Border Margin="0,0,8,0" Classes="card" VerticalAlignment="Top">
      <StackPanel Spacing="6">
        <TextBlock Classes="h2" Text="Combat" />
        <Border Classes="sep" Margin="0,2,0,4" />
        <Grid ColumnDefinitions="*,150" MinHeight="34">
          <TextBlock Classes="label" Text="Basic attack (ms)" />
          <NumericUpDown Grid.Column="1" Value="{Binding AttackIntervalMs}" Minimum="30" Maximum="2000" Increment="10" FormatString="0" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Auto shift lock during rounds (enemies present = always on)" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoShiftLock}" /></Grid>
        <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Ultimate (G) only on bosses (boss bar shown, not IMMUNE)" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding UltBossOnly}" /></Grid>
        <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Carry: stop at damage (0 = off, then idle until win)" /><NumericUpDown Grid.Column="1" Value="{Binding CarryDamage}" Minimum="0" Maximum="10000000" Increment="100" FormatString="0" /></Grid>
        <Grid ColumnDefinitions="*,Auto" MinHeight="34"><TextBlock Classes="label" Text="Shadow Lord: auto Arise on Shadow Gate (hold E on corpses)" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoArise}" /></Grid>
        <ItemsControl ItemsSource="{Binding SkillRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SkillRowViewModel">
              <Border Classes="card" Padding="0" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <Border Background="{DynamicResource OfAccentDim}" CornerRadius="8,0,0,8" MinWidth="48" Padding="10,8"
                          BorderBrush="{DynamicResource OfBorder}" BorderThickness="0,0,1,0">
                    <TextBlock Text="{Binding KeyText}" Classes="accent" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Classes="label" Text="{Binding Name}" Margin="10,0" />
                  <Button Grid.Column="2" Content="{Binding RebindText}" Command="{Binding RebindCommand}" Padding="10,4" MinWidth="78"
                          HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="3" IsChecked="{Binding Enabled}" Margin="8,0,4,0" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Border Grid.Column="1" Margin="8,0,0,0" Classes="card" VerticalAlignment="Top">
      <StackPanel Spacing="6">
        <TextBlock Classes="h2" Text="Navigation" />
        <Border Classes="sep" Margin="0,2,0,4" />
        <Grid ColumnDefinitions="*,150" MinHeight="34">
          <TextBlock Classes="label" Text="Attack range (stud)" />
          <NumericUpDown Grid.Column="1" Value="{Binding AttackRange}" Minimum="2" Maximum="150" Increment="1" FormatString="0" />
        </Grid>
        <Grid ColumnDefinitions="*,150" MinHeight="34">
          <TextBlock Classes="label" Text="Arrive radius (stud)" />
          <NumericUpDown Grid.Column="1" Value="{Binding ArriveRadius}" Minimum="2" Maximum="20" Increment="1" FormatString="0" />
        </Grid>
        <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                   Text="Attack range: distance kept from enemies (± 10%, min 2 stud) while attacking, using skills and circling. Arrive radius: the next area point counts as reached when this close (4–8 recommended)." />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
